[gd_resource type="Resource" script_class="RuleGuideCatalog" format=3]

[ext_resource type="Script" path="res://narrative/rule_guide.gd" id="1_ry4gq"]
[ext_resource type="Script" path="res://narrative/rule_guide_catalog.gd" id="2_0rrju"]

[sub_resource type="Resource" id="Resource_aeh4i"]
script = ExtResource("1_ry4gq")
rule_id = &"and_intro"
title = "并织机"
summary = "[占位] 两股丝并成一幅。"
body = "[占位] 左口收 A、右口收 B,织出并纹 [b]A ∧ B[/b]。要两样都在场,才织得出。"
demo_formula = "A & B"

[sub_resource type="Resource" id="Resource_wfa5t"]
script = ExtResource("1_ry4gq")
rule_id = &"and_elim"
title = "拆股机"
summary = "[占位] 把并纹拆回两股。"
body = "[占位] 收一幅 [b]A ∧ B[/b],上口吐 A、下口吐 B。任取一股接着用。"
demo_formula = "A & B"

[sub_resource type="Resource" id="Resource_s01ur"]
script = ExtResource("1_ry4gq")
rule_id = &"or_intro"
title = "岔纹机"
summary = "[占位] 已有其一,便可宣称二者有其一。"
body = "[占位] 收 A,上口织 [b]A ∨ ?[/b]、下口织 [b]? ∨ A[/b]。另一支不来自输入,点标题「钉上口/钉下口」自己指定。"
demo_formula = "A | B"

[sub_resource type="Resource" id="Resource_baxx4"]
script = ExtResource("1_ry4gq")
rule_id = &"or_elim"
title = "汇路机"
summary = "[占位] 无论走哪条岔路,终点相同,结论便立。"
body = "[占位] 收一个 [b]A ∨ B[/b] 和两条各自得出同一结论的支路,汇成那个结论。两个假设口的纹样由 0 号口自动定,不用钉。"
demo_formula = "A | B"

[sub_resource type="Resource" id="Resource_xprj8"]
script = ExtResource("1_ry4gq")
rule_id = &"imp_intro"
title = "封程机"
summary = "[占位] 空手立一张「若…则…」的承诺。"
body = "[占位] 最难的一台。① 点「钉纹样」钉住假设 P;② 用它织出 Q;③ 封装成 [b]P → Q[/b],假设就此放电。详见织者笔记。"
demo_formula = "A > B"

[sub_resource type="Resource" id="Resource_i5tw1"]
script = ExtResource("1_ry4gq")
rule_id = &"imp_elim"
title = "引渡机"
summary = "[占位] 有承诺又有前件,兑现后件。"
body = "[占位] 收 [b]A → B[/b] 和 A,吐出 B。承诺加上钥匙,取出里面的货。"
demo_formula = "A > B"

[sub_resource type="Resource" id="Resource_5cghl"]
script = ExtResource("1_ry4gq")
rule_id = &"false_elim"
title = "溃散机"
summary = "[占位] 从谬误里,能织出任何纹样。"
body = "[占位] 收一幅焦纹 [b]⊥[/b],想织什么由你钉 —— 爆炸原理。烧穿的布,织什么都「成立」,故极危险。"
demo_formula = "A"

[resource]
script = ExtResource("2_0rrju")
entries = Array[ExtResource("1_ry4gq")]([SubResource("Resource_aeh4i"), SubResource("Resource_wfa5t"), SubResource("Resource_s01ur"), SubResource("Resource_baxx4"), SubResource("Resource_xprj8"), SubResource("Resource_i5tw1"), SubResource("Resource_5cghl")])
