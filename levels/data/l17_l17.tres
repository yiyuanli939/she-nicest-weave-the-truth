[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://narrative/dialogue_line.gd" id="1_hdgte"]
[ext_resource type="Script" path="res://narrative/dialogue_res.gd" id="2_gpb8j"]
[ext_resource type="Script" path="res://levels/level_def.gd" id="3_weddg"]

[sub_resource type="Resource" id="Resource_tyn4t"]
script = ExtResource("1_hdgte")
speaker = "小机"
text = "[占位] ……在你的证明里,我找回了前提。谢谢你,织者。"
side_right = true
robot_cue = "calm"

[sub_resource type="Resource" id="Resource_uhw3y"]
script = ExtResource("2_gpb8j")
lines = Array[ExtResource("1_hdgte")]([SubResource("Resource_tyn4t")])
