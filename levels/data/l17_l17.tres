[resource]
script = ExtResource("3_weddg")
id = &"l17"
title = "归于平静"
assumptions = Array[String](["A > B"])
goal = "(A > false) | B"
allowed_rules = Array[StringName]([&"and_intro", &"and_elim", &"imp_intro", &"imp_elim", &"or_intro", &"or_elim", &"false_elim", &"tnd"])
atoms = Array[StringName]([&"A", &"B"])
allow_bot = true
intro_dialogue = SubResource("Resource_uhw3y")
notebook_unlocks = Array[StringName]([&"notebook_tnd"])
robot_cue_on_enter = "glitch"
robot_cue_on_win = "celebrate"
