[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://narrative/dialogue_line.gd" id="1_flmij"]
[ext_resource type="Script" path="res://narrative/dialogue_res.gd" id="2_e2nhv"]
[ext_resource type="Script" path="res://levels/level_def.gd" id="3_whgl2"]

[sub_resource type="Resource" id="Resource_flmij"]
script = ExtResource("1_flmij")
speaker = "亚瑟·威客利夫"
text = "拉芙蒂小姐，你是否见过一本黑色笔记？昨日可能遗落在这里。"
scene = "工坊"
left_char = "亚瑟"

[sub_resource type="Resource" id="Resource_e2nhv"]
script = ExtResource("1_flmij")
speaker = "诺拉·拉芙蒂"
text = "在检验台下面。我昨晚才发现是您的。给您。"
scene = "工坊"
left_char = "亚瑟"

[sub_resource type="Resource" id="Resource_whgl2"]
script = ExtResource("1_flmij")
speaker = "亚瑟·威客利夫"
text = "谢谢。你翻过吗？"
scene = "工坊"
left_char = "亚瑟"

[sub_resource type="Resource" id="Resource_568a1"]
script = ExtResource("1_flmij")
speaker = "诺拉·拉芙蒂"
text = "只看见了几页。那些规则……和我们的织法很像。"
scene = "工坊"
left_char = "亚瑟"

[sub_resource type="Resource" id="Resource_8tgij"]
script = ExtResource("1_flmij")
speaker = "亚瑟·威客利夫"
text = "相似的操作并不等于相同的知识。工坊知道怎样做出稳定纹样，学院研究的是它为何必然成立。"
scene = "工坊"
left_char = "亚瑟"

[sub_resource type="Resource" id="Resource_bpotd"]
script = ExtResource("1_flmij")
speaker = "诺拉·拉芙蒂"
text = "可如果规则完全一样呢？"
scene = "工坊"
left_char = "亚瑟"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_hnd1j"]
script = ExtResource("1_flmij")
speaker = "亚瑟·威客利夫"
text = "那也需要定义、证明和可检验的记录。没有这些，经验很难成为知识。"
scene = "工坊"
left_char = "亚瑟"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_jljsi"]
script = ExtResource("2_e2nhv")
lines = Array[ExtResource("1_flmij")]([SubResource("Resource_flmij"), SubResource("Resource_e2nhv"), SubResource("Resource_whgl2"), SubResource("Resource_568a1"), SubResource("Resource_8tgij"), SubResource("Resource_bpotd"), SubResource("Resource_hnd1j")])

[resource]
script = ExtResource("3_whgl2")
id = &"l08"
title = "第三纹"
assumptions = Array[String](["A > B", "B > C"])
goal = "A > C"
allowed_rules = Array[StringName]([&"and_intro", &"and_elim", &"imp_elim", &"imp_intro"])
atoms = Array[StringName]([&"A", &"B", &"C"])
intro_dialogue = SubResource("Resource_jljsi")
robot_cue_on_win = "celebrate"
