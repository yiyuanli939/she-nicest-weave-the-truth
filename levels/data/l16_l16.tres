[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://narrative/dialogue_line.gd" id="1_s5mpa"]
[ext_resource type="Script" path="res://narrative/dialogue_res.gd" id="2_uyl2u"]
[ext_resource type="Script" path="res://levels/level_def.gd" id="3_moebh"]

[sub_resource type="Resource" id="Resource_p2el1"]
script = ExtResource("1_s5mpa")
speaker = "小机"
text = "[占位] 警告——检测到排中律注入!我、我的推理核心在过热——"
side_right = true
robot_cue = "panic"

[sub_resource type="Resource" id="Resource_5ekrp"]
script = ExtResource("2_uyl2u")
lines = Array[ExtResource("1_s5mpa")]([SubResource("Resource_p2el1")])

[resource]
script = ExtResource("3_moebh")
id = &"l16"
title = "两仪"
goal = "A | (A > false)"
allowed_rules = Array[StringName]([&"and_intro", &"and_elim", &"imp_intro", &"imp_elim", &"or_intro", &"or_elim", &"false_elim", &"tnd"])
atoms = Array[StringName]([&"A"])
allow_bot = true
intro_dialogue = SubResource("Resource_5ekrp")
robot_cue_on_enter = "panic"
robot_cue_on_win = "celebrate"
