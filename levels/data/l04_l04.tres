[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://narrative/dialogue_line.gd" id="1_sk1ha"]
[ext_resource type="Script" path="res://narrative/dialogue_res.gd" id="2_nkml8"]
[ext_resource type="Script" path="res://levels/level_def.gd" id="3_lp67d"]

[sub_resource type="Resource" id="Resource_sk1ha"]
script = ExtResource("1_sk1ha")
speaker = "诺拉·拉芙蒂"
text = "威客利夫先生走得真急……等等，检验台下面这本黑色笔记，是他的吧？"
scene = "工坊"
nora_expr = "惊讶"

[sub_resource type="Resource" id="Resource_nkml8"]
script = ExtResource("1_sk1ha")
speaker = "诺拉·拉芙蒂"
text = "威客利夫先生的……我明天还给他吧。"
scene = "工坊"
nora_expr = "严肃"

[sub_resource type="Resource" id="Resource_lp67d"]
script = ExtResource("1_sk1ha")
speaker = "诺拉·拉芙蒂"
text = "我只是想确认扉页上的名字……这页画的结构怎么这么眼熟？"
scene = "诺拉房间"
nora_expr = "严肃"

[sub_resource type="Resource" id="Resource_0wxft"]
script = ExtResource("1_sk1ha")
speaker = "诺拉·拉芙蒂"
text = "我们有A为真，也有B为真，因此可以得到“A且B”，或者说“A合取B”为真……"
scene = "诺拉房间"
nora_expr = "严肃"

[sub_resource type="Resource" id="Resource_vltgm"]
script = ExtResource("1_sk1ha")
speaker = "诺拉·拉芙蒂"
text = "把字符换成颜色，把“为真”换成“纹样”……这不就是……并织吗？"
scene = "诺拉房间"
nora_expr = "惊讶"

[sub_resource type="Resource" id="Resource_f4nwn"]
script = ExtResource("2_nkml8")
lines = Array[ExtResource("1_sk1ha")]([SubResource("Resource_sk1ha"), SubResource("Resource_nkml8"), SubResource("Resource_lp67d"), SubResource("Resource_0wxft"), SubResource("Resource_vltgm")])

[resource]
script = ExtResource("3_lp67d")
id = &"l04"
title = "第四纹"
assumptions = Array[String](["A & (B & C)"])
goal = "(A & B) & C"
allowed_rules = Array[StringName]([&"and_intro", &"and_elim"])
atoms = Array[StringName]([&"A", &"B", &"C"])
intro_dialogue = SubResource("Resource_f4nwn")
robot_cue_on_win = "celebrate"
