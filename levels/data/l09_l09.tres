[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://narrative/dialogue_line.gd" id="1_1j3q3"]
[ext_resource type="Script" path="res://narrative/dialogue_res.gd" id="2_trim7"]
[ext_resource type="Script" path="res://levels/level_def.gd" id="3_na7fi"]

[sub_resource type="Resource" id="Resource_1j3q3"]
script = ExtResource("1_1j3q3")
speaker = "诺拉·拉芙蒂"
text = "莉娅，刚才那台旧织机怎么同时闪了两道光？你停机也太熟练了，难道经常这样？"
scene = "工坊"
nora_expr = "惊讶"

[sub_resource type="Resource" id="Resource_trim7"]
script = ExtResource("1_1j3q3")
speaker = "诺拉·拉芙蒂"
text = "刚才那两道光是怎么回事？"
scene = "工坊"
nora_expr = "惊讶"

[sub_resource type="Resource" id="Resource_na7fi"]
script = ExtResource("1_1j3q3")
speaker = "莉娅·科尔宾"
text = "三号静语丝受潮后的“余响”。上一种状态有时候不会立刻消干净，会和下一种叠一小会儿。"
scene = "工坊"
left_char = "莉娅"
left_expr = "苦恼"
nora_expr = "惊讶"

[sub_resource type="Resource" id="Resource_1trig"]
script = ExtResource("1_1j3q3")
speaker = "诺拉·拉芙蒂"
text = "学院知道吗？"
scene = "工坊"
left_char = "莉娅"
left_expr = "苦恼"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_dbvdn"]
script = ExtResource("1_1j3q3")
speaker = "莉娅·科尔宾"
text = "我两年前就写过。湿度、线批、出现次数，全记了。"
scene = "工坊"
left_char = "莉娅"
left_expr = "苦恼"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_mn6vw"]
script = ExtResource("1_1j3q3")
speaker = "莉娅·科尔宾"
text = "他们把纸退回来，说“缺乏合资格观察者确认，不纳入公档”。后来我就把它钉在我们自己的记录册里了。"
scene = "工坊"
left_char = "莉娅"
left_expr = "苦恼"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_fq3od"]
script = ExtResource("1_1j3q3")
speaker = "诺拉·拉芙蒂"
text = "可如果它真的会影响机器呢？"
scene = "工坊"
left_char = "莉娅"
left_expr = "苦恼"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_r0vmd"]
script = ExtResource("1_1j3q3")
speaker = "莉娅·科尔宾"
text = "那就等机器出事以后，他们再派一位先生来重新发现一遍吧。"
scene = "工坊"
left_char = "莉娅"
left_expr = "苦恼"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_3gfex"]
script = ExtResource("2_trim7")
lines = Array[ExtResource("1_1j3q3")]([SubResource("Resource_1j3q3"), SubResource("Resource_trim7"), SubResource("Resource_na7fi"), SubResource("Resource_1trig"), SubResource("Resource_dbvdn"), SubResource("Resource_mn6vw"), SubResource("Resource_fq3od"), SubResource("Resource_r0vmd")])

[resource]
script = ExtResource("3_na7fi")
id = &"l09"
title = "第四纹"
goal = "A > (B > A)"
allowed_rules = Array[StringName]([&"and_intro", &"and_elim", &"imp_elim", &"imp_intro"])
atoms = Array[StringName]([&"A", &"B"])
intro_dialogue = SubResource("Resource_3gfex")
robot_cue_on_win = "celebrate"
