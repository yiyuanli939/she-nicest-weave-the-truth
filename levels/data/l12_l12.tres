[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://narrative/dialogue_line.gd" id="1_fl7da"]
[ext_resource type="Script" path="res://narrative/dialogue_res.gd" id="2_p7gpl"]
[ext_resource type="Script" path="res://levels/level_def.gd" id="3_adydy"]

[sub_resource type="Resource" id="Resource_v2tng"]
script = ExtResource("1_fl7da")
speaker = "诺拉·拉芙蒂"
text = "连着下了几天雨以后就不对劲了。邮报机把一封信判给两条路，清扫机来回改向，连门禁都能同时亮“允许”和“拒绝”。"
text_en = "After several days of rain things went wrong. The post machine sends one letter down two routes, the sweepers keep changing direction, even the door guards light “allow” and “deny” at the same time."
scene = "伦敦街上"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_s6a8h"]
script = ExtResource("1_fl7da")
speaker = "诺拉·拉芙蒂"
text = "它不是选错了一条路……它像是同时认出了两条互相冲突的状态。"
text_en = "It didn't pick the wrong path… it's as if it recognized two conflicting states at once."
scene = "伦敦街上"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_you30"]
script = ExtResource("1_fl7da")
speaker = "诺拉·拉芙蒂"
text = "小织也是，前几天被人不小心放在窗台旁淋了雨，现在连句完整的话都说不出来，机械厂来的维修工却说他们也找不到问题……"
text_en = "Bobbin too. A few days ago someone left it by the window and it got rained on; now it can't get a whole sentence out, and the repairman from the machine works says they can't find the fault either…"
scene = "伦敦街上"
nora_expr = "苦恼"

[sub_resource type="Resource" id="Resource_jl3nv"]
script = ExtResource("1_fl7da")
speaker = "亚瑟·威客利夫"
text = "请远离那台机器。学院已经收到异常报告。初步判断是部分工坊纹样偏离程式。"
text_en = "Please keep away from that machine. The Academy has received the anomaly reports. The preliminary judgment is that some workshop patterns have strayed from the programme."
scene = "伦敦街上"
left_char = "亚瑟"
nora_expr = "严肃"

[sub_resource type="Resource" id="Resource_2v3ua"]
script = ExtResource("1_fl7da")
speaker = "诺拉·拉芙蒂"
text = "如果纹样没偏呢？"
text_en = "And if the patterns haven't strayed?"
scene = "伦敦街上"
left_char = "亚瑟"
nora_expr = "严肃"

[sub_resource type="Resource" id="Resource_dbv23"]
script = ExtResource("1_fl7da")
speaker = "亚瑟·威客利夫"
text = "那么就只能是推演器本身发生了故障。"
text_en = "Then the only possibility is a fault in the reasoning engine itself."
scene = "伦敦街上"
left_char = "亚瑟"
nora_expr = "严肃"

[sub_resource type="Resource" id="Resource_voh5c"]
script = ExtResource("2_p7gpl")
lines = Array[ExtResource("1_fl7da")]([SubResource("Resource_v2tng"), SubResource("Resource_s6a8h"), SubResource("Resource_you30"), SubResource("Resource_jl3nv"), SubResource("Resource_2v3ua"), SubResource("Resource_dbv23")])

[resource]
script = ExtResource("3_adydy")
id = &"l12"
title = "第二纹"
assumptions = Array[String](["A | B"])
goal = "B | A"
allowed_rules = Array[StringName]([&"and_intro", &"and_elim", &"imp_elim", &"imp_intro", &"or_intro", &"or_elim"])
atoms = Array[StringName]([&"A", &"B"])
intro_dialogue = SubResource("Resource_voh5c")
robot_cue_on_win = "celebrate"
